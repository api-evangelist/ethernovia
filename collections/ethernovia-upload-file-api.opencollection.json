{
  "opencollection": "1.0.0",
  "info": {
    "name": "DOCUMENTATION Upload - File API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Upload - File",
        "type": "folder"
      },
      "items": [
